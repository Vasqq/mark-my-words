{
  "name": "mark-my-words",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run && node --test server/*.test.mjs",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server scripts vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check src server scripts vite.config.ts tsconfig.json package.json .prettierrc.json",
    "check": "npm run typecheck && npm run format:check",
    "parity:reference": "node docs/frontend/parity-check.mjs run --target docs/frontend/reference/perpl-reference.html --out verification/parity/reference",
    "parity:app": "node docs/frontend/parity-check.mjs run --target \"http://127.0.0.1:4175/?mode=demo\" --out verification/parity/app",
    "parity:compare": "node docs/frontend/parity-check.mjs compare verification/parity/reference verification/parity/app",
    "live": "node scripts/live-dev.mjs"
  },
  "dependencies": {
    "@fontsource/inter-tight": "5.2.7",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@privy-io/react-auth": "3.48.1",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-slider": "1.3.6",
    "@stripe/stripe-js": "1.54.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "overrides": {
    "ws@>=8.0.0 <8.21.0": "8.22.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
